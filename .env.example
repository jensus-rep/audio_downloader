UNI_USERNAME=meinekennung
UNI_PASSWORD=meinpasswort
LOGIN_URL=https://uni.example.com/login

# Login-Selektoren an die jeweilige Uni-Seite anpassen:
USERNAME_SELECTOR=input[name="username"]
PASSWORD_SELECTOR=input[name="password"]
LOGIN_BUTTON_SELECTOR=button[type="submit"]

# Optional: Ein Element, das nur im eingeloggten Zustand sichtbar ist.
# LOGGED_IN_SELECTOR=a[href*="logout"]

# Optional: Regulärer Ausdruck für die URL nach erfolgreichem Login.
# LOGIN_SUCCESS_URL_PATTERN=/kurs|/dashboard

HEADLESS=true
LOGIN_TIMEOUT_MS=30000
PAGE_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=120000
DOWNLOAD_DIR=downloads
FAILED_DOWNLOADS_FILE=failed_downloads.txt
